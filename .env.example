# Copy this file to .env.local and fill in values. Never commit real keys.
# These are read server-side only (src/lib/env.ts). The app builds without any of them;
# searches need the Qloo values.

# Required for searches. Qloo API key, sent as the X-Api-Key header.
QLOO_API_KEY=
# Required for searches. Qloo base URL from Qloo's hackathon developer guide.
QLOO_API_BASE_URL=
# Optional. Without it, Tastora uses its built-in (deterministic) planner instead of Claude.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5 (see docs/agent.md).
ANTHROPIC_MODEL=

# Optional, only for `npm run matrix` (scripts/profile-matrix.ts):
# MATRIX_QLOO_BUDGET=90        # max Qloo calls per run
# MATRIX_ANTHROPIC_BUDGET=70   # max Anthropic requests per run
# MATRIX_OUT=matrix-out        # output folder for JSON summaries
